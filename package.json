{
  "name": "cppocket",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:android:arm-v8a": "APP_VARIANT=production npx expo prebuild && cd android && gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a && cd ..",
    "build:android:debug-arm-v8a": "npx expo prebuild && cd android && gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a && cd ..",
    "push:release": "adb install android/app/build/outputs/apk/debug/app-release.apk",
    "push:debug": "adb install android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@expo/vector-icons": "^15.0.3",
    "@getpapillon/papicons": "^0.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.105.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-checkbox": "~58.0.2",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "ical.js": "^2.2.1",
    "nativewind": "^4.2.6",
    "node-html-parser": "^9.0.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-remark": "^1.0.5",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-toast-message": "^2.5.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
